  {
   "kind": "voiceover",
   "t": 9.517,
   "duration": 6.161,
   "text": "Here is a typical sentence from a manual. It has sixteen words. Some of the words do not help the reader.",
   "bookmarks": {
    "count": 12.067
   },
   "scene": "Ste80"
  },
  {
   "kind": "bookmark",
   "t": 12.083,
   "mark": "count",
