  },
  {
   "kind": "voiceover",
   "t": 41.15,
   "duration": 5.82,
   "text": "Settle B, at three. Through B, D is three plus five: eight. Eight is shorter than ten.",
   "bookmarks": {
    "r0": 42.662
   },
   "scene": "Dijkstra"
  },
  {
   "kind": "bookmark",
   "t": 42.65,
   "mark": "r0",
