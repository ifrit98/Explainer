 "events": [
  {
   "kind": "voiceover",
   "t": 0.0,
   "duration": 6.025,
   "text": "A language model must pick the next word. Here it has four candidates: cat, dog, fox, and owl.",
   "bookmarks": {},
   "scene": "SoftmaxTemperature"
  },
  {
   "kind": "voiceover_end",
   "t": 6.017,
   "issues": [],
   "scene": "SoftmaxTemperature"
  },
  {
   "kind": "voiceover",
   "t": 6.017,
   "duration": 6.183,
   "text": "The model gives each candidate a score. The score is called a logit. Cat has the highest logit.",
   "bookmarks": {
    "line": 8.46
   },
   "scene": "SoftmaxTemperature"
  },
  {
   "kind": "bookmark",
   "t": 8.45,
   "mark": "line",
   "issues": [],
   "scene": "SoftmaxTemperature"
  },
  {
   "kind": "voiceover_end",
   "t": 12.183,
   "issues": [],
   "scene": "SoftmaxTemperature"
  },
  {
   "kind": "voiceover",
   "t": 12.183,
   "duration": 5.747,
   "text": "Softmax turns the logits into probabilities. At temperature one, cat gets sixty-one percent.",
   "bookmarks": {
    "bars": 15.072
   },
   "scene": "SoftmaxTemperature"
  },
  {
   "kind": "bookmark",
   "t": 15.072,
   "mark": "bars",
   "issues": [],
   "scene": "SoftmaxTemperature"
  },
  {
   "kind": "voiceover_end",
   "t": 17.922,
   "issues": [],
   "scene": "SoftmaxTemperature"
  },
  {
   "kind": "voiceover",
   "t": 17.922,
   "duration": 8.636,
   "text": "Temperature divides every logit before softmax. At T equal to one half, the logits move apart. Cat now gets eighty-four percent.",
   "bookmarks": {
    "cold": 21.295
   },
   "scene": "SoftmaxTemperature"
  },
  {
   "kind": "bookmark",
   "t": 21.288,
   "mark": "cold",
   "issues": [],
   "scene": "SoftmaxTemperature"
  },
  {
