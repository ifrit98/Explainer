   "issues": [],
   "scene": "SoftmaxTemperature"
  },
  {
   "kind": "voiceover",
   "t": 17.946,
   "duration": 8.636,
   "text": "Temperature divides every logit before softmax. At T equal to one half, the logits move apart. Cat now gets eighty-four percent.",
   "bookmarks": {
    "cold": 21.319
   },
   "scene": "SoftmaxTemperature"
  },
  {
   "kind": "bookmark",
   "t": 21.312,
   "mark": "cold",
