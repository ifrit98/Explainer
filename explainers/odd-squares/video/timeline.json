  {
   "kind": "voiceover",
   "t": 8.983,
   "duration": 6.661,
   "text": "Every sum is a square number. Five examples show a pattern. They do not prove a rule. A picture can.",
   "bookmarks": {},
   "scene": "OddSquares"
  },
  {
   "kind": "voiceover_end",
   "t": 15.633,
   "issues": [],
   "scene": "OddSquares"
  },
  {
   "kind": "voiceover",
   "t": 15.633,
   "duration": 9.933,
   "text": "Start with one square. Three squares wrap it into a two by two square. Five more make three by three. Seven make four by four. Nine make five by five.",
   "bookmarks": {
    "g2": 17.155,
    "g3": 20.092,
    "g4": 22.124,
    "g5": 23.96
   },
   "scene": "OddSquares"
  },
  {
