  {
   "kind": "voiceover",
   "t": 13.5,
   "duration": 14.93,
   "text": "Look at the answers. One is one times one. Four is two times two. Nine is three times three. Sixteen is four times four. Twenty-five is five times five. Every sum is a square number. Yellow marks what to look at.",
   "bookmarks": {
    "s1": 14.913,
    "s2": 16.723,
    "s3": 18.569,
    "s4": 20.444,
    "s5": 22.558
   },
   "scene": "OddSquares"
  },
  {
   "kind": "bookmark",
