  {
   "kind": "predict",
   "t": 171.828,
   "question": "What is the sum of the first ten odd numbers?",
   "scene": "OddSquares"
  },
  {
   "kind": "voiceover",
   "t": 171.828,
   "duration": 3.891,
   "text": "Pause here and predict. What is the sum of the first ten odd numbers?",
   "bookmarks": {},
   "scene": "OddSquares"
  },
  {
   "kind": "voiceover_end",
   "t": 175.712,
   "issues": [],
   "scene": "OddSquares"
  },
  {
   "kind": "voiceover",
   "t": 178.712,
   "duration": 19.823,
   "text": "Ten Ls make a square with side ten: one hundred tiles. The five new Ls are eleven, thirteen, fifteen, seventeen, and nineteen, each in its own color. The first L is one, and each of the nine Ls after it adds two: one plus nine times two is nineteen. So the first ten odd numbers add up to one hundred.",
   "bookmarks": {
    "new": 182.366,
    "tenth": 188.838,
    "ten": 195.673
   },
   "scene": "OddSquares"
  },
  {
   "kind": "bookmark",
   "t": 182.362,
   "mark": "new",
   "issues": [],
   "scene": "OddSquares"
  },
  {
   "kind": "bookmark",
   "t": 188.828,
   "mark": "tenth",
   "issues": [],
   "scene": "OddSquares"
  },
  {
   "kind": "bookmark",
   "t": 195.662,
   "mark": "ten",
   "issues": [],
   "scene": "OddSquares"
  },
  {
   "kind": "voiceover_end",
   "t": 198.528,
   "issues": [],
   "scene": "OddSquares"
  },
  {
   "kind": "voiceover",
   "t": 199.728,
   "duration": 10.906,
   "text": "The first tile matters. Start at three instead: three plus five is eight. Without the first tile, the Ls go around a hole. Nine minus one is eight, and eight is not a square.",
   "bookmarks": {
    "s3": 201.395,
    "need": 204.485
   },
   "scene": "OddSquares"
  },
  {
   "kind": "bookmark",
   "t": 201.395,
   "mark": "s3",
   "issues": [],
   "scene": "OddSquares"
  },
  {
   "kind": "claim",
   "t": 201.395,
   "id": "guarantee-every-n",
   "scene": "OddSquares"
  },
  {
   "kind": "bookmark",
   "t": 204.478,
